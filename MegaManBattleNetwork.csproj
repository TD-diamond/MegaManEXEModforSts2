<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <PlatformTarget>x64</PlatformTarget>
    <BaseOutputPath>F:\A_MyRepositories\GithubRepositories\MegaManEXE\bin</BaseOutputPath>
    <Sts2DataDir>G:\SteamLibrary\steamapps\common\Slay the Spire 2\data_sts2_windows_x86_64</Sts2DataDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <Optimize>false</Optimize>
    <DebugType>portable</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <PathMap>$(AppOutputBase)=.\</PathMap>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Src\Potions\" />
    <Folder Include="Src\Scripts\" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>G:\SteamLibrary\steamapps\common\Slay the Spire 2\data_sts2_windows_x86_64\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="BaseLib">
      <HintPath>G:\SteamLibrary\steamapps\common\Slay the Spire 2\mods\BaseLib\BaseLib.dll</HintPath>
    </Reference>
    <Reference Include="sts2">
      <HintPath>G:\SteamLibrary\steamapps\common\Slay the Spire 2\data_sts2_windows_x86_64\sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="MegaManBattleNetwork" AfterTargets="PostBuildEvent">
    <Message Text="G:\SteamLibrary\steamapps\common\Slay the Spire 2\mods" Importance="high" />
    <MakeDir Directories="G:\SteamLibrary\steamapps\common\Slay the Spire 2\mods\" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="G:\SteamLibrary\steamapps\common\Slay the Spire 2\mods\$(MSBuildProjectName)\" />
    <!-- 新增 -->
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="G:\SteamLibrary\steamapps\common\Slay the Spire 2\mods\$(MSBuildProjectName)/" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    <Copy SourceFiles="build\$(MSBuildProjectName).json" DestinationFolder="G:\SteamLibrary\steamapps\common\Slay the Spire 2\mods\$(MSBuildProjectName)/" />
  </Target>
</Project>